# Copie este arquivo para .env e ajuste os valores

# "production" no servidor: exige senha forte e ativa as proteções de produção
NODE_ENV="development"

# Senha para entrar no painel web (se ficar vazio, uma senha é gerada e mostrada no terminal).
# Em produção é obrigatória, com pelo menos 12 caracteres. Trocar a senha encerra todas as sessões abertas.
CRM_PASSWORD=""

# Porta e endereço do painel
PORT=3000
# 0.0.0.0 = acessível por outros aparelhos da sua rede | 127.0.0.1 = só neste computador
HOST="0.0.0.0"

# Coloque "true" se acessar o painel por HTTPS (Cloudflare Tunnel, Nginx etc.)
COOKIE_SECURE="false"

# Endereço público do painel (ex.: https://crm.promocoesbrasil.com.br). Bloqueia ações vindas de outros sites.
PUBLIC_URL=""

# Proxies confiáveis para descobrir o IP real do visitante ("loopback" = Nginx na mesma máquina)
TRUST_PROXY="loopback"

# Pasta onde ficam o banco de dados e os contatos
DATA_DIR="./data"

# Comandos "!" (ex.: !ping) enviados por você mesmo no WhatsApp
COMMANDS_ENABLED="true"
