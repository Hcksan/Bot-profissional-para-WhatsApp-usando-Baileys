{
  "name": "whatsapp-bot",
  "version": "2.0.0",
  "description": "CRM pessoal para WhatsApp com Baileys: Kanban, agendamentos, campanhas e painel web",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch-path=src --watch-path=public src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "crm"
  ],
  "author": "Gabriel Santana @gabrielxsanttana",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "argon2": "0.44.0",
    "baileys": "7.0.0-rc14",
    "express": "5.2.1",
    "pino": "9.5.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "socket.io": "4.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
